# ai_code2doc — environment configuration
# Copy this file to .env and fill in your values.

# ─── LLM: ai_code2doc (Layer 1 / Layer 3 generation) ───
AI_CODE2DOC_LLM_API_KEY=
AI_CODE2DOC_LLM_BASE_URL=https://api.openai.com/v1
AI_CODE2DOC_LLM_MODEL=gpt-4o
AI_CODE2DOC_LLM_MAX_TOKENS=4096
AI_CODE2DOC_LLM_TEMPERATURE=0.1
AI_CODE2DOC_LLM_CONCURRENCY=3
AI_CODE2DOC_LLM_PROVIDER=openai

# ─── LLM: layer2_mcp (POST /update) ───
LAYER2_LLM_API_KEY=
LAYER2_LLM_BASE_URL=https://api.openai.com/v1
LAYER2_LLM_MODEL=gpt-4o
LAYER2_LLM_MAX_TOKENS=4096
LAYER2_LLM_TEMPERATURE=0.1

# ─── General ───
AI_CODE2DOC_LOG_LEVEL=INFO
